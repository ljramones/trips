<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Minimal Checkstyle configuration for TRIPS.

  Today this enforces exactly one rule: no string concatenation inside SLF4J
  `log.*` calls — use parameterized logging instead. This is the same rule
  documented in AGENTS.md > "Logging" and previously surfaced manually via
  scripts/check-logging.sh; the Phase 7.4 sweep brought the violation count
  to zero, and this configuration prevents regressions.

  Why a single-purpose config: we don't want to fight a thousand existing
  style violations across a mature codebase. Add new rules only when we've
  cleaned the existing breaches, the same way 7.4 prepared the ground for
  this one.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!--
      Single-line concatenation inside log.* calls.

      Matches the same pattern as scripts/check-logging.sh:
        log.<level>( "..." +
      catches the common single-line form. Multi-line concatenations
      that span across line breaks are extremely rare in this codebase
      (we cleaned them all out in Phase 7.4) and a single-line regex
      is much faster than full TreeWalker analysis.

      GOOD:  log.info("loaded {} stars", count);
      BAD:   log.info("loaded " + count + " stars");
    -->
    <module name="RegexpSingleline">
        <property name="format" value="log\.(trace|debug|info|warn|error)\(\s*&quot;[^&quot;]*&quot;\s*\+"/>
        <!-- {} must be escaped as '{}' because Checkstyle runs the message
             through java.text.MessageFormat, which treats unescaped { } as
             positional parameter markers. -->
        <property name="message"
                  value="SLF4J log call uses string concatenation — use parameterized logging instead, e.g. log.info(&quot;count='{}'&quot;, count). See AGENTS.md &gt; Logging."/>
        <property name="fileExtensions" value="java"/>
    </module>
</module>
