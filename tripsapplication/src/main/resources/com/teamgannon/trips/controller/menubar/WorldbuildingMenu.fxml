<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>

<Menu xmlns:fx="http://javafx.com/fxml/1" text="_Worldbuilding" mnemonicParsing="true"
      fx:controller="com.teamgannon.trips.controller.menubar.WorldbuildingMenuController">
    <MenuItem fx:id="spaceshipModellerMenuItem"
              text="Spaceship Modeller..."
              onAction="#openSpaceshipModeller"/>
    <MenuItem fx:id="installationDesignerMenuItem"
              text="_Installations Designer..."
              mnemonicParsing="true"
              onAction="#openInstallationDesigner"/>
    <!-- Transfer Planner is launched in-context from the Solar System view
         (right-click a body → "Plan Transfer from Here..."); the global
         menu entry was misleading because the planner needs a system
         context to be useful. Keep the openTransferPlanner handler in
         WorldbuildingMenuController for direct calls but don't surface it here. -->

</Menu>
